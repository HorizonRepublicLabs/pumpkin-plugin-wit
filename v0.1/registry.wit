package pumpkin:plugin@0.1.0;

/// Registration of content the server does not ship with.
///
/// Every definition starts from a vanilla template and overrides what it needs. Copying is
/// deliberate: a block carries dozens of fields and a full set of block states, and most
/// custom content wants "stone, but mine" rather than a definition built from nothing.
///
/// # When to call this
///
/// Registration is only open while plugins are loading. Call these from `on-load`; the
/// server freezes its registries once every plugin has loaded, and from that point ids are
/// fixed for the lifetime of the process and every function here fails. That is what lets
/// the server hand ids to clients and read them back without synchronising.
///
/// The window does not reopen, so a hot-reloaded plugin cannot register content. Registered
/// content needs a server restart.
interface registry {
  /// A block to add to the server's registry.
  record block-definition {
    /// Namespaced id, e.g. `examplemod:ruby_block`. The `minecraft` namespace is reserved.
    id: string,
    /// Vanilla block whose definition and block states are copied, e.g. `stone`.
    template: string,
    /// Replaces the template's hardness when set.
    hardness: option<f32>,
    /// Replaces the template's blast resistance when set.
    blast-resistance: option<f32>,
    /// Replaces the template's light emission, 0 to 15, when set.
    luminance: option<u8>,
  }

  /// An item to add to the server's registry.
  record item-definition {
    /// Namespaced id, e.g. `examplemod:ruby`. The `minecraft` namespace is reserved.
    id: string,
    /// Vanilla item whose definition and components are copied, e.g. `diamond`.
    template: string,
  }

  /// An entity type to add to the server's registry.
  record entity-type-definition {
    /// Namespaced id, e.g. `examplemod:ruby_golem`. The `minecraft` namespace is reserved.
    id: string,
    /// Vanilla entity type whose definition is copied, e.g. `allay`.
    template: string,
  }

  /// Registers a block and returns the id it was assigned.
  register-block: func(definition: block-definition) -> result<u32, string>;

  /// Registers an item and returns the id it was assigned.
  register-item: func(definition: item-definition) -> result<u32, string>;

  /// Registers an entity type and returns the id it was assigned.
  register-entity-type: func(definition: entity-type-definition) -> result<u32, string>;

  /// The protocol phase a network channel is used in.
  enum channel-protocol {
    /// In play, after the client has joined the world. Where most mod traffic lives.
    play,
    /// During configuration, before the client joins.
    configuration,
  }

  /// A modded network channel the server is willing to carry.
  record network-channel {
    /// Namespaced channel id, e.g. `mysticalagriculture:update_aoe_offset`.
    id: string,
    /// The phase the channel is used in.
    protocol: channel-protocol,
    /// The version the mod registered its payloads under. NeoForge compares this against
    /// the client's, so it must match the mod's `event.registrar("...")` argument exactly.
    version: string,
    /// Whether the server listens on this channel, which decides whether it is announced
    /// to the client on `minecraft:register`.
    serverbound: bool,
  }

  /// Declares a channel to negotiate with NeoForge clients.
  ///
  /// A mod refuses to join a server that did not negotiate every channel it registered as
  /// required, so a plugin implementing that mod's server half must declare them all —
  /// including the ones only the client ever sends on, which the server simply ignores.
  declare-network-channel: func(channel: network-channel) -> result<_, string>;

  /// Whether registration has closed. True once every plugin has finished loading.
  is-frozen: func() -> bool;
}
