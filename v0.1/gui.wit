interface gui {
    use text.{text-component};
    use common.{click-type};
    use item-stack.{item-stack};
    use screens.{screen};

    /// A screen a mod draws itself, rather than one of vanilla's.
    ///
    /// The client resolves `menu-type` through the registry sync, so the menu has to have
    /// been registered. `extra-data` is whatever the mod's own menu constructor reads —
    /// usually a block position, packed the way Minecraft packs one, so the screen knows
    /// which machine it is looking at.
    record modded-screen {
        /// Namespaced id of a registered menu type, e.g. `mysticalagriculture:reprocessor`.
        menu-type: string,
        /// Slots the menu has, matching the mod's own container.
        slots: u32,
        /// Extra bytes the menu's constructor reads.
        extra-data: list<u8>,
    }

    resource gui {
        constructor(%type: screen, title: text-component);

        /// Builds a screen drawn by a mod. Fails if the menu type was never registered.
        modded: static func(screen: modded-screen, title: text-component) -> result<gui, string>;
        set-item: func(slot: u32, item: item-stack);
        get-item: func(slot: u32) -> option<item-stack>;
        
        /// Returns the type of this GUI.
        get-type: func() -> screen;
        
        /// Returns the title of this GUI.
        get-title: func() -> text-component;
        
        /// Returns the number of slots in this GUI.
        get-size: func() -> u32;
        
        /// Clears all items from the GUI.
        clear-items: func();

        /// Sets whether players can grab items out of the inventory.
        set-allow-grab-items: func(allow: bool);

        /// Returns whether players can grab items out of the inventory.
        get-allow-grab-items: func() -> bool;

        /// Sets whether players can put items into the inventory from their own.
        set-allow-put-items: func(allow: bool);

        /// Returns whether players can put items into the inventory from their own.
        get-allow-put-items: func() -> bool;
    }
}
